    "D": {
      "label": "Battute",
      "items": [
        {
          "id": "d-1",
          "speaker": "guide",
          "ruolo": "esterno",
          "english": "Hello everyone! Nice to meet you. Can you introduce yourselves?",
          "italian": "Ciao a tutti! Piacere di conoscervi. Potete presentarvi?"
        },
        {
          "id": "d-2",
          "speaker": "papa",
          "ruolo": "famiglia",
          "english": "Hello, I'm {{papa}}. I'm from {{partenza}}, Italy.",
          "italian": "Ciao, sono {{papa}}. Vengo da {{partenza}}, Italia."
        },
        {
          "id": "d-3",
          "speaker": "guide",
          "ruolo": "esterno",
          "english": "Nice to meet you, {{papa}}. And you?",
          "italian": "Piacere, {{papa}}. E tu?"
        },
        {
          "id": "d-4",
          "speaker": "mamma",
          "ruolo": "famiglia",
          "english": "Hi, I'm {{mamma}}. I'm {{papa}}'s wife.",
          "italian": "Ciao, sono {{mamma}}. Sono la moglie di {{papa}}."
        },
        {
          "id": "d-5",
          "speaker": "figlia",
          "ruolo": "famiglia",
          "english": "Hi, I'm {{figliaNome}}. I'm {{figliaEta}} years old.",
          "italian": "Ciao, sono {{figliaNome}}. Ho {{figliaEta}} anni."
        },
        {
          "id": "d-6",
          "speaker": "figlio",
          "ruolo": "famiglia",
          "english": "Hello, I'm {{figlioNome}}. I'm {{figlioEta}}.",
          "italian": "Ciao, sono {{figlioNome}}. Ho {{figlioEta}} anni."
        },
        {
          "id": "d-7",
          "speaker": "guide",
          "ruolo": "esterno",
          "english": "Great! Welcome to the trip, {{papa}}'s family!",
          "italian": "Ottimo! Benvenuti al viaggio, famiglia di {{papa}}!"
        }
      ]
    }
  },
  "generalRule": "La \"e\" finale in inglese non si legge quasi mai.",
