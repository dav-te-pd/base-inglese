  "vocabulary": [
    { "id": "hello", "english": "Hello", "italian": "Ciao / Salve", "pronunciationTip": "L'accento cade sulla seconda sillaba: \"hel-LOU\", non \"E-lo\". La \"h\" si sente appena, un soffio.", "grammarCategory": "interiezione/saluto" },
    { "id": "everyone", "english": "everyone", "italian": "tutti", "pronunciationTip": "\"EV-ri-uan\", accento sulla prima sillaba.", "grammarCategory": "pronome indefinito" },
    { "id": "nice-to-meet-you", "english": "Nice to meet you", "italian": "Piacere di conoscerti/vi", "pronunciationTip": "La \"ee\" di \"meet\" è lunga e tesa (non \"mit\" secco all'italiana): \"nais tu MIIT yu\".", "grammarCategory": "espressione idiomatica" },
    { "id": "can", "english": "Can", "italian": "Puoi / Potete", "pronunciationTip": "La \"a\" è aperta, quasi come \"kan\" ma più schiacciata.", "grammarCategory": "verbo modale" },
    { "id": "introduce", "english": "introduce", "italian": "presentare", "pronunciationTip": "Accento sull'ultima sillaba: \"in-tro-DIUS\".", "grammarCategory": "verbo" },
    { "id": "yourselves", "english": "yourselves", "italian": "voi stessi", "pronunciationTip": "\"yor-SELVZ\", la \"s\" finale suona \"z\".", "grammarCategory": "pronome riflessivo" },
    { "id": "im", "english": "I'm", "italian": "Sono / Mi chiamo", "pronunciationTip": "È la contrazione di \"I am\", si pronuncia tutta attaccata: \"aim\", mai \"ai-em\" staccato.", "grammarCategory": "pronome + verbo essere" },
    { "id": "from", "english": "from", "italian": "da / di", "pronunciationTip": "La \"o\" è una via di mezzo tra \"a\" e \"o\" aperta, non la \"o\" chiusa italiana: suona quasi \"fram\".", "grammarCategory": "preposizione" },
    { "id": "hi", "english": "Hi", "italian": "Ciao", "pronunciationTip": "Dittongo lungo \"hai\", più informale di \"Hello\".", "grammarCategory": "interiezione/saluto" },
    { "id": "wife", "english": "wife", "italian": "moglie", "pronunciationTip": "\"uaif\" — la \"w\" è un suono labiale che non esiste in italiano.", "grammarCategory": "sostantivo" },
    { "id": "years-old", "english": "years old", "italian": "... anni", "pronunciationTip": "\"years\" parte quasi come \"ie-ars\"; \"old\" ha la \"o\" lunga: \"ould\".", "grammarCategory": "espressione per età" },
    { "id": "great", "english": "Great", "italian": "Ottimo / Fantastico", "pronunciationTip": "Si legge \"greit\", non \"great\" all'italiana.", "grammarCategory": "aggettivo" },
    { "id": "welcome", "english": "Welcome", "italian": "Benvenuto/i", "pronunciationTip": "L'accento è tutto sulla prima sillaba: \"WEL-com\", la seconda parte si \"mangia\" leggermente.", "grammarCategory": "interiezione/saluto" },
    { "id": "trip", "english": "trip", "italian": "viaggio", "pronunciationTip": "La \"r\" è morbida, non arrotata come in italiano.", "grammarCategory": "sostantivo" },
