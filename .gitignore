# Dipendenze
node_modules/

# Prodotti da un giro di test (tests/run_full_regression.sh)
tests/*.result.txt
tests/server.log
tests/suite.log

# Prodotti dagli script di tests/tools/ (screenshot)
tests/output/

# Sistema
.DS_Store

# Lanciando la suite dalla radice con una redirezione a mano (2026-09-19):
# .gitignore copriva solo tests/suite.log, e un log da 400 righe e' finito
# in un commit. Un file di lavoro che entra nel repository non fa danno e non
# si vede — ed e' per questo che la riga sta qui invece che nella memoria.
suite.log
server.log

# Prodotti da tests/tools/stress.sh (2026-09-24): un log per giro, e i giri
# sono tanti per costruzione. Stessa ragione di suite.log qui sopra — un file
# di lavoro che entra nel repository non fa danno e non si vede.
tests/stress-giro*.log
